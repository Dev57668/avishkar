# API Keys
CLAUDE_API_KEY=sk-ant-your-key-here
GITHUB_TOKEN=ghp_your-token-here
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Database
DATABASE_PATH=./security_debt.db

# Directories
UPLOAD_DIR=./uploads
WORKSPACE_DIR=./workspaces
LOG_DIR=./logs

# Scanner paths (Windows example)
GITLEAKS_PATH=C:\tools\gitleaks\gitleaks.exe

# Limits
MAX_FILE_SIZE_MB=50
MAX_SCAN_TIME_SECONDS=300
WORKSPACE_CLEANUP_MINUTES=30

# AI Settings
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.3
AI_TIMEOUT_SECONDS=30
AI_MAX_CONCURRENT=10

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
