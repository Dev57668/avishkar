# Isolated scan worker. Build: docker build -f infra/Dockerfile.worker -t avishkar-worker:latest .
# Network is only needed at BUILD time; runtime uses --network none.
# TODO(hardening): pin the base image by digest (python:3.12-slim@sha256:...) once chosen (spec App. N).
FROM python:3.12-slim
ARG SEMGREP_VERSION=1.178.0
ARG GITLEAKS_VERSION=8.21.2
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
 && pip install --no-cache-dir "semgrep==${SEMGREP_VERSION}" \
 && cd /tmp \
 && curl -sSfLO "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
 && curl -sSfLO "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_checksums.txt" \
 && grep " gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz\$" "gitleaks_${GITLEAKS_VERSION}_checksums.txt" | sha256sum -c - \
 && tar -xzf "gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" -C /usr/local/bin gitleaks \
 && rm -f /tmp/gitleaks_* && cd / \
 && apt-get purge -y curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY avishkar/__init__.py avishkar/
COPY avishkar/domain avishkar/domain
COPY avishkar/workers avishkar/workers
COPY config config
COPY infra/semgrep-rules.yml infra/semgrep-rules.yml
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app HOME=/tmp SEMGREP_SEND_METRICS=off
USER 65534:65534
# `python -I` ignores PYTHONPATH, so the package root is inserted explicitly (found by the docker-sandbox CI job).
ENTRYPOINT ["python", "-I", "-c", "import sys;sys.path.insert(0,'/app');from avishkar.workers.sandbox_child import main;raise SystemExit(main())"]
