# Isolated scan worker. Build: docker build -f infra/Dockerfile.worker -t avishkar-worker:latest .
# Pin by digest in production (spec App. N). Network is only needed at BUILD time; runtime uses --network none.
FROM python:3.12-slim@sha256:REPLACE_WITH_PINNED_DIGEST
ARG SEMGREP_VERSION=1.178.0
ARG GITLEAKS_VERSION=8.21.2
# Set to the published checksum for the pinned release; the build fails if it does not match.
ARG GITLEAKS_SHA256=REPLACE_WITH_RELEASE_CHECKSUM
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
 && pip install --no-cache-dir "semgrep==${SEMGREP_VERSION}" \
 && curl -sSfL -o /tmp/gl.tgz "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
 && echo "${GITLEAKS_SHA256}  /tmp/gl.tgz" | sha256sum -c - \
 && tar -xzf /tmp/gl.tgz -C /usr/local/bin gitleaks && rm /tmp/gl.tgz \
 && apt-get purge -y curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY avishkar/__init__.py avishkar/
COPY avishkar/domain avishkar/domain
COPY avishkar/workers avishkar/workers
COPY config config
COPY infra/semgrep-rules.yml infra/semgrep-rules.yml
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app HOME=/tmp SEMGREP_SEND_METRICS=off
USER 65534:65534
ENTRYPOINT ["python", "-I", "-m", "avishkar.workers.sandbox_child"]
